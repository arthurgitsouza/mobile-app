      "peso": 20
    },
    {
      "id": "c2",
      "nome": "Consistência dos dados",
      "peso": 20
    },
    {
      "id": "c3",
      "nome": "Segurança e controle de acesso",
      "peso": 15
    },
    {
      "id": "c4",
      "nome": "Rastreabilidade e auditoria",
      "peso": 15
    },
    {
      "id": "c5",
      "nome": "Funcionamento em condições reais",
      "peso": 15
    },
    {
