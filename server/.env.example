# Copie para server/.env e preencha. O .env NUNCA vai para o GitHub.
# Supabase → Project Settings → API

# URL do projeto (ex.: https://abcdxyz.supabase.co)
SUPABASE_URL=

# Chave "anon / publishable": usada no login (Supabase Auth)
SUPABASE_ANON_KEY=

# Chave "service_role / secret": acesso total ao banco. Só no servidor, nunca no app.
SUPABASE_SERVICE_KEY=

# Bucket do Storage onde ficam as fotos dos RDOs
SUPABASE_BUCKET_FOTOS=fotos-rdo

# Porta da API (o Render define PORT sozinho)
PORT=3001

# Origens liberadas no CORS, separadas por vírgula (* libera todas; o app nativo não usa CORS)
CORS_ORIGINS=*
